<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WorldObjectDef>
    <defName>IEE_PilgrimCamp</defName>
    <label>pilgrim camp</label>
    <description>A temporary community of travelers gathered around a shared ideology.</description>

    <worldObjectClass>IdeologyExpandedEnclaves.PilgrimCamp</worldObjectClass>

    <mapGenerator>Encounter</mapGenerator>
    <overrideMapSize>(120,1,120)</overrideMapSize>

    <texture>World/WorldObjects/DefaultSettlement</texture>
    <selectable>true</selectable>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>IEE_EnclaveExpeditionSite</defName>
    <label>enclave expedition site</label>
    <description>A temporary regional camp dispatched by a nearby enclave.</description>
    <worldObjectClass>IdeologyExpandedEnclaves.EnclaveExpeditionSite</worldObjectClass>
    <mapGenerator>Encounter</mapGenerator>
    <overrideMapSize>(90,1,90)</overrideMapSize>
    <texture>World/WorldObjects/DefaultSettlement</texture>
    <selectable>true</selectable>
  </WorldObjectDef>
</Defs>
